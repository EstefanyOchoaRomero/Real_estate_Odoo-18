
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
            id="estate_report_property"
            string="Property Report"
            model="estate.property"
            report_type="qweb-pdf"
            name="estate.report_property"
            file="demo_estate.report_property"
            print_report_name="'Property - %s' % (object.name)"
        />

    <data>
        <record id="property_report" model="ir.actions.report">
            <field name="name">Property Report Offers</field>
            <field name="model">estate.property</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">demo_estate.report_property</field>
            <field name="report_file">demo_estate.report_property</field>
            <field name="print_report_name">'Property Offers'</field>
            <field name="binding_model_id" ref="model_estate_property"/>
            <field name="binding_type">action</field>
            <field name="multi">True</field>
            <field name="binding_view_types">list,form</field>
            
            
        </record>

         <record id="base_act_report_xml_view" model="ir.actions.report">
            <field name="name">XML Report View</field>
            <field name="model">estate.property</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">demo_estate.report_xml_view</field>
            <field name="report_file">demo_estate.report_xml_view</field>
            <field name="print_report_name">'XML Report View'</field>
            <field name="binding_model_id" ref="model_estate_property"/>
        </record>

    </data>


</odoo>

<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <template id="report_all_properties">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>All Properties Report</h2>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Expected Price</th>
                                <th>Area (sqm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="property">
                                <tr>
                                    <td><span t-field="property.name"/></td>
                                    <td><span t-field="property.expected_price"/></td>
                                    <td><span t-field="property.living_area"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>

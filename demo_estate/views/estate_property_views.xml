<?xml version="1.0" encoding="UTF-8"?>


<odoo>


    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>


    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_property_tag" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>


    <record id="demo_estate_property_tree_view" model="ir.ui.view">
        <field name="name">estate.property.tree.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'offer_received'">
                <field name="name"/>
                <field name="name_title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="show"/>
                <field name="property_type_id"/>
            </list>
        </field>
    </record>


    <record id="view_estate_property_type_tree" model="ir.ui.view">
        <field name="name">estate.property.type.tree</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record> 


    <record id="view_estate_property_tag_tree" model="ir.ui.view">
                <field name="name">property.tag.tree</field>
                <field name="model">estate.property.tag</field>
                <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>


    <record id="view_estate_property_offer_tree" model="ir.ui.view">
                <field name="name">estate.property.offer.tree</field>
                <field name="model">estate.property.offer</field>
                <field name="arch" type="xml">
            <list editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'" decoration-muted="status == 'sold'">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status" invisible="1"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="property_id"/>
            </list>
        </field>
    </record>


    <record id="demo_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                
                    
                    <button name="action_mark_as_sold" type="object" string="Sold" class="btn btn-success"
                    invisible="not show_action_buttons"/>
                    <button name="action_mark_as_canceled" type="object" string="Cancel" class="btn btn-danger"
                    invisible="not show_action_buttons"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Property Name" required="1"/>
                            <field name="name_title" string="Title" required="1"/>
                        </group>
                        <group>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="partner_id"/>
                            <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                            <field name="status"/>
                            <field name="best_price" readonly="1" />
                            <field name="property_id"/>
                        </group>    
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not show_garden_fields"/>
                                <field name="total_area" invisible="not show_garden_fields"/>
                                <field name="garden_orientation" invisible="not show_garden_fields"/>
                            </group>
                        </page>
                        <page string="Sales Information">
                            <group>
                                <field name="buyer_id" string="Buyer"/>
                                <field name="salesperson_id" string="Salesperson" readonly="1"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offer_ids" readonly="state in ('accepted', 'sold', 'cancelled')">
                                    <list editable="bottom" decoration-success="status=='accepted'" decoration-danger="status=='refused'">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="status"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <button name="action_accept_offer" type="object" string="Accept" icon="fa-check" class="btn btn-success"
                                        invisible="status"/>
                                        <button name="action_reject_offer" type="object" string="Refuse" icon="fa-times" class="btn btn-danger"
                                        invisible="status"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook> 
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_estate_property_type_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <header>
                    <button name="%(estate_property_offer_action)d" type="action"
                            string="View Offers" class="oe_stat_button"
                            icon="fa fa-list"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" string="Name"/>
                        <field name="code" string="Code"/>
                    </group>
                    <group>
                        <field name="property_ids">
                            <list>
                                <field name="name"/>
                                <field name="expected_price"/>
                                <field name="state"/>
                            </list>
                        </field>
                </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_estate_property_tag_form" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <group> 
                    <field name="price"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="validity"/>
                    <field name="date_deadline"/>
                    <field name="property_id"/>
                </group>
            </form>
        </field>
    </record>


    <record id="view_users_form_inherited" model="ir.ui.view">
        <field name="name">res.users.form.inherited</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="property_ids" widget="one2many_list" context="{'default_state': 'new'}"/>
                        </group>
                    </sheet>
                </form>
        </field>
    </record>


    <record id="estate_property_search_view" model="ir.ui.view">
                <field name="name">estate.property.search.view</field>
                <field name="model">estate.property</field>
                <field name="arch" type="xml">
            <search string="Search Estate Properties">
                <field name="property_type_id"/>
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area', '>=', self)]"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/> 
                <filter name="available_properties" string="Available"
                        domain="[('state', 'in', ('new', 'offer_received'))]"/>
                <filter name="sold_properties" string="Sold"
                        domain="[('state', '=', 'sold')]"/>
                <filter name="active_properties" string="Active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>


</odoo>












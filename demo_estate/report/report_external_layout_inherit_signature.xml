<?xml version="1.0" encoding="UTF-8"?>


<odoo>


    <template inherit_id="demo_estate.estate_property_approved_report" id="report_approved_offers_inherit_signature">
        <xpath expr="//div[@class='page']" position="inside">
            <table style="width: 100%; margin-top: 20px; border-collapse: collapse;">
                <tr>
                    <td style="text-align: left; white-space: nowrap;">Approved by:_______________________________</td>
                    <td style="width: 100%;"></td>
                    <td style="text-align: right; white-space: nowrap;"><strong>Date:</strong> <span t-esc="time.strftime('%Y-%m-%d')"/></td>
                </tr>
            </table>
        </xpath>
    </template>


</odoo>











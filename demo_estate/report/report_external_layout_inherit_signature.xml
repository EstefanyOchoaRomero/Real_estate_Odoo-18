<?xml version="1.0" encoding="UTF-8"?>


<odoo>


    <template inherit_id="demo_estate.estate_property_approved_report" id="report_approved_offers_inherit_signature">
        <xpath expr="//div[@class='page']" position="inside">
            
            <div class="signature" style="margin-top: 50px;">
                <p>Approved by:</p>
                <p>__________________________ <strong>Date:</strong> <span t-esc="time.strftime('%Y-%m-%d')"/></p>
            </div>
            <div class="date" style="margin-top: 20px; text-align: right;">
            </div>
        </xpath>
    </template>


</odoo>

<?xml version="1.0" encoding="UTF-8"?>


<odoo>


    <template id="estate_property_approved_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="display: flex; flex-direction: column; min-height: 100%; box-sizing: border-box;">
                    <div style="flex: 1; overflow: hidden;">
                        <div style="transform: scale(0.95); transform-origin: top left;">
                            <h2>Approved and Proposed Offers</h2>
                            <t t-if="docs">
                                <table class="table table-sm" style="width: 100%;">
                                    <thead>
                                        <tr style="background-color: #74649c; color: white;">
                                            <th>Property</th>
                                            <th>Partner</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="docs.mapped('offer_ids')" t-as="offer">
                                            <t t-if="offer.status == 'accepted' or not offer.status">
                                                <tr t-attf-style="background-color: #{ 'lightgreen' if offer.status == 'accepted' else '#f0f0f0' };">
                                                    <td><span t-field="offer.property_id.name"/></td>
                                                    <td><span t-field="offer.partner_id"/></td>
                                                    <td><span t-field="offer.price"/></td>
                                                    <td><span t-esc="offer.status or 'Proposed'"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p>No data to preview. This is a placeholder for the Approved and Proposed Offers report.</p>
                            </t>
                        </div>
                    </div>
                    <div style="border-top: 1px solid #ccc; padding-top: 10px; font-size: 12px; margin-top: auto;">
                        <div style="display: flex; justify-content: space-between;">
                            <div>
                                <strong>Signature:</strong>
                                <br/><br/>
                                ___________________________
                            </div>
                            <div>
                                <strong>Date:</strong>
                                <br/>
                                
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>


</odoo>
